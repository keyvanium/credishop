{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_code": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "trade",
        "payment",
        "account",
        "store",
        "other"
      ],
      "default": "other"
    },
    "message": {
      "type": "string"
    },
    "trade_id": {
      "type": "string"
    },
    "trade_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "answered",
        "closed"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal"
    },
    "replies_count": {
      "type": "number",
      "default": 0
    },
    "last_reply_at": {
      "type": "string"
    },
    "last_reply_by": {
      "type": "string"
    }
  },
  "required": [
    "ticket_code",
    "user_id",
    "subject"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
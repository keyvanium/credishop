{
  "name": "Evidence",
  "type": "object",
  "properties": {
    "trade_id": {
      "type": "string"
    },
    "trade_code": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_role": {
      "type": "string",
      "enum": [
        "buyer",
        "seller",
        "admin"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "receipt",
        "screenshot",
        "statement",
        "message",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared",
        "admin_only"
      ],
      "default": "private"
    },
    "shared_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed": {
      "type": "boolean",
      "default": false
    },
    "review_note": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "trade_id",
    "owner_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.shared_with": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Referral",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "referrer_id": {
      "type": "string"
    },
    "referrer_name": {
      "type": "string"
    },
    "invitee_id": {
      "type": "string"
    },
    "invitee_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "joined",
        "qualified",
        "rewarded",
        "rejected"
      ],
      "default": "joined"
    },
    "trade_id": {
      "type": "string"
    },
    "reward_points": {
      "type": "number",
      "default": 0
    },
    "reward_amount": {
      "type": "number",
      "default": 0
    },
    "qualified_at": {
      "type": "string"
    },
    "rewarded_at": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "referrer_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.invitee_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.referrer_id": "{{user.id}}"
        },
        {
          "data.invitee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "OrderPromotion",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "order_code": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "featured",
        "top"
      ],
      "default": "featured"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "pending_payment",
        "active",
        "expired",
        "cancelled"
      ],
      "default": "requested"
    },
    "starts_at": {
      "type": "string"
    },
    "ends_at": {
      "type": "string"
    },
    "payment_reference": {
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}